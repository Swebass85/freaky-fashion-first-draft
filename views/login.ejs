<!DOCTYPE html>
<html lang="en">
  <%- include("partials/head", {
  title: "Login",
  scripts: []
}) %>

  <body class="login-page">
    <header>
      <div class="login__site--header">
        <img
          src="/images/logo-mobile.webp"
          alt="Freaky Fashion Logo"
          id="header__logotyp"
        />

        <div class="login__header--items">
          <h1>Welcome back</h1>
          <p class="auth__subtitle">Log in or create an account</p>
        </div>

        <div class="header__icons">
          <a href="/favorites" class="favorites-header">
            <img
              src="/icons/heart-fill.svg"
              alt="heart icon"
              class="nav__icons nav__icons--favorites-size"
              id="heart__icon"
            />

            <span class="icon-count" id="favorites-count">
              <%= session?.favoritesCount || session?.favorites?.length || 0 %>
            </span>
          </a>

          <a href="/basket" class="basket-header">
            <img
              src="/icons/shopping-basket-thick.svg"
              class="nav__icons nav__icons--basket-size"
              alt="basket"
              id="basket-icon"
            />

            <span class="icon-count" id="basket-count">
              <%= session?.basketCount || session?.basket?.length || 0 %>
            </span>
          </a>

          <% if (locals.user) { %>
            <a href="/logout">
              <img
                src="/icons/log-out.svg"
                alt="logout icon"
                class="nav__icons"
              />
            </a>
          <% } else { %>
            <a href="/login">
              <img
                src="/icons/log-in.svg"
                alt="login icon"
                class="nav__icons"
              />
            </a>
          <% } %>
        </div>
      </div>

      <nav class="header__nav">
        <ul>
          <li><a href="/news">Nyheter</a></li>
          <li><a href="/products">Kläder</a></li>
          <li><a href="/about">Accessoarer</a></li>
          <li><a href="/contact">Skor</a></li>
          <li><a href="/contact">Mitt konto</a></li>
          <li><a href="/">Startsida</a></li>
        </ul>
      </nav>
    </header>

    <main class="auth">
      <div class="auth__container">
        <form class="auth__form" action="/login" method="POST">
          <h2>Login</h2>

          <input name="email" type="email" placeholder="Email" required />
          <input name="password" type="password" placeholder="Password" required />

          <button type="submit">Login</button>
          <a href="/" class="guest-button">Continue as guest</a>
        </form>

        <p>or</p>

        <form class="auth__form" action="/register" method="POST">
          <h2>Create account</h2>

          <input name="first_name" placeholder="First name" required />
          <input name="last_name" placeholder="Last name" required />
          <input name="email" type="email" placeholder="Email" required />
          <input name="password" type="password" placeholder="Password" required />
          <input name="birthday" type="date" />

          <button type="submit">Sign up</button>
        </form>
      </div>

      <section class="login__hero">
        <video class="login__hero--video" autoplay muted loop playsinline>
          <source src="/images/hero-video.mp4" type="video/mp4" />
        </video>
      </section>
    </main>
    <%- include("partials/footer") %>
  </body>
</html>
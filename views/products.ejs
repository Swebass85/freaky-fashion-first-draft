<!DOCTYPE html>
<html lang="en">
  <%- include("partials/head", {
    title: product.type,
    scripts: [
      "/javascripts/search.js",
      "/javascripts/favorites.js",
      "/javascripts/basket.js"
    ]
  }) %>

  <body>
    <%- include("partials/header") %>

    <main class="main">
      <section class="product__page">
        <div class="product__page--image-wrapper">
          <img
            src="<%= product.picture_front %>"
            alt="Picture of <%= product.type %>"
            class="product__page--image"
          >
        </div>

        <div class="product__page--info">
          <div class="product__page--header">
            <h1><%= product.type %></h1>
            <h2><%= product.brand %></h2>

            <p><%= product.description %></p>

            <div class="product__page--purchase-box">
              <div class="product__page--purchase-header">
                <h3>Pris</h3>
                <h3><%= product.price %> SEK</h3>
              </div>

              <div class="product__page--purchase-row">
                <label for="quantity">Antal</label>

                <select
                  id="quantity"
                  name="quantity"
                  class="product-detail-quantity"
                  data-product-id="<%= product.id %>"
                >
                  <% for (let i = 1; i <= 5; i++) { %>
                    <option value="<%= i %>"><%= i %> st</option>
                  <% } %>
                </select>
              </div>

              <div class="product__page--button-wrapper">
                <button
                  class="product__page--add-to-cart add-to-cart-btn"
                  data-product-id="<%= product.id %>"
                  type="button"
                >
                  Lägg i varukorg
                </button>

                <button
                  class="product__page--add-to-favorites add-to-favorites-btn <%= product.isFavorite ? 'active' : '' %>"
                  data-product-id="<%= product.id %>"
                  type="button"
                >
                  Lägg till i favoriter
                </button>
              </div>
            </div>
          </div>
        </div>
      </section>

      <% if (relatedProducts.length > 0) { %>
        <div class="carousel__wrapper">
          <input type="radio" name="slider" id="slide1" checked>
          <input type="radio" name="slider" id="slide2">

          <div class="carousel">
            <h1>Liknande produkter</h1>

            <div class="carousel-track">
              <% relatedProducts.forEach(relatedProduct => { %>
                <div class="carousel-item">
                  <div class="card">
                    <a href="/products/<%= relatedProduct.slug %>">
                      <div class="product__page--image-wrapper">
                        <img
                          src="<%= relatedProduct.picture_front %>"
                          alt="<%= relatedProduct.type %>"
                        >
                      </div>
                    </a>

                    <div class="card-categories">
                      <h2><%= relatedProduct.type %></h2>
                      <h3><%= relatedProduct.price %> SEK</h3>
                      <p><%= relatedProduct.brand %></p>
                    </div>
                  </div>
                </div>
              <% }) %>
            </div>

            <label for="slide1" class="carousel__nav prev">‹</label>
            <label for="slide2" class="carousel__nav next">›</label>
          </div>
        </div>
      <% } %>

      <%- include("partials/services") %>
    </main>

    <%- include("partials/footer") %>
  </body>
</html>
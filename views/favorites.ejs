<!DOCTYPE html>
<html lang="en">
  <%- include("partials/head", {
  title: "Mina favoriter",
  scripts: [
    "/javascripts/search.js",
    "/javascripts/favorites.js",
    "/javascripts/basket.js"
  ]
}) %>
  <body>
    
 <%- include("partials/header") %>

    <main class="favorites__main">
      <section class="favorites_hero">
        <div class="hero__info">
          <h1>Freaky Fashion</h1>
          <p>Välkommen till sommarens hetaste look!</p>
        </div>
        <div class="hero__info--1024-wrapper">
          <div class="hero__info--1024">
            <% if (!locals.user) { %>
  <h1>Freaky Fashion</h1>
<% } %>
             <% if (locals.user) { %>
    <h3 class="hero__username">
      Hej <%= locals.user.first_name %>
    </h3>
  <% } %>
            <h2>Här har vi samlat alla dina favoriter</h2>
          </div>
        </div><!-- /hero__info--1024-wrapper -->
      </section>
      
      <section class="products">
  <% products.forEach(product => { %>
    <%- include("partials/product-card", { product, session }) %>
  <% }) %>
</section>
     
      <%- include("partials/services") %>
    </main> <!-- /main -->

    <%- include("partials/footer") %>
  </body>
</html>

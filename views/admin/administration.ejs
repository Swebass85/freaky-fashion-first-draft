<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="/stylesheets/style.css">
  <title>Administration</title>
</head>

<body>
  <header class="admin__header">
    <div class="site__header">
      <h1>Administration</h1>
    </div>
  </header>

  <main class="admin__main">
    <%- include("partials/sidebar") %>

    <section class="produkter">
      <table class="admin__table">
        <thead>
          <tr>
            <th>Namn</th>
            <th>Beskrivning</th>
            <th>Märke</th>
            <th>Kategori</th>
            <th>SKU</th>
            <th>Pris</th>
            <th>Publicerad</th>
            <th></th>
          </tr>
        </thead>

        <tbody>
          <% products.forEach(product => { %>
            <tr>
              <td><%= product.type %></td>
              <td><%= product.description %></td>
              <td><%= product.brand %></td>
              <td><%= product.category_name || "-" %></td>
              <td><%= product.sku %></td>
              <td><%= product.price %> kr</td>
              <td><%= product.created_at %></td>

              <td class="icons">
                <span class="penna">
                  <a href="/admin/products/<%= product.id %>/edit">
                    <img
                      src="/icons/square-pen.svg"
                      alt="Redigera produkt"
                    >
                  </a>
                </span>

                <form
                  action="/admin/products/<%= product.id %>/delete"
                  method="POST"
                  class="admin__delete-form"
                >
                  <button type="submit" class="admin__icon-button">
                    <img
                      src="/icons/trash.svg"
                      alt="Ta bort produkt"
                    >
                  </button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>

      <a href="/admin/products/new" class="admin__button">
        Lägg till produkt
      </a>
    </section>
  </main>
</body>
</html>
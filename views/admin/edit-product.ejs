<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="/stylesheets/style.css">
  <title><%= title %></title>
</head>

<body>
  <header class="admin__header">
    <div class="site__header">
      <h1>Administration</h1>
    </div>
  </header>

  <main class="admin__main">
    <%- include("partials/sidebar") %>

    <section class="admin__forms">
      <div class="admin__form-card">

        <h2>
          <%= isNew ? "Lägg till produkt" : "Redigera produkt" %>
        </h2>

        <form
          class="admin__form"
          action="<%= isNew
            ? '/admin/products/new'
            : '/admin/products/' + product.id + '/edit'
          %>"
          method="POST"
          enctype="multipart/form-data"
        >

          <label>Namn</label>
          <input
            type="text"
            name="type"
            maxlength="25"
            value="<%= product.type || '' %>"
            required
          >

          <label>Beskrivning</label>
          <input
            type="text"
            name="description"
            value="<%= product.description || '' %>"
            required
          >

          <label>Bild</label>

          <div class="admin__edit-images">

            <div class="admin__edit-image-group">
              <span>Frontbild</span>

              <% if (product.picture_front) { %>
                <img
                  src="<%= product.picture_front %>"
                  class="admin__preview-img"
                  alt="Frontbild"
                >
              <% } %>

              <input
                type="file"
                name="picture_front"
                accept="image/*"
              >
            </div>

            <div class="admin__edit-image-group">
              <span>Bakbild</span>

              <% if (product.picture_back) { %>
                <img
                  src="<%= product.picture_back %>"
                  class="admin__preview-img"
                  alt="Bakbild"
                >
              <% } %>

              <input
                type="file"
                name="picture_back"
                accept="image/*"
              >
            </div>

          </div>

          <label>Märke</label>
          <input
            type="text"
            name="brand"
            value="<%= product.brand || '' %>"
            required
          >

          <label>Kategori</label>

          <select name="category_id" required>
            <option value="">Välj kategori</option>

            <% categories.forEach(category => { %>
              <option
                value="<%= category.id %>"
                <%= String(product.category_id || '') === String(category.id)
                  ? 'selected'
                  : ''
                %>
              >
                <%= category.name %>
              </option>
            <% }) %>
          </select>

          <label>SKU</label>

          <div class="admin__sku">

            <input
              type="text"
              name="sku_letters"
              maxlength="3"
              pattern="[A-Z]{3}"
              value="<%= product.sku ? product.sku.slice(0, 3) : '' %>"
              placeholder="ABC"
              required
            >

            <input
              type="text"
              name="sku_numbers"
              maxlength="3"
              pattern="[0-9]{3}"
              value="<%= product.sku ? product.sku.slice(3) : '' %>"
              placeholder="123"
              required
            >

          </div>

          <label>Pris</label>
          <input
            type="number"
            name="price"
            min="0"
            value="<%= product.price || '' %>"
            required
          >

          <label>Publiceringsdatum</label>
          <input
            type="datetime-local"
            name="created_at"
            value="<%= product.created_at
              ? product.created_at.replace(' ', 'T').slice(0, 16)
              : ''
            %>"
            required
          >

          <div></div>

          <button
            type="submit"
            class="admin__button"
          >
            <%= isNew ? "Lägg till" : "Spara ändringar" %>
          </button>

        </form>

      </div>
    </section>
  </main>
</body>
</html>
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Freaky Fashion</title>
    <link rel="icon" href="icons/favicon-16px.png" />
    <link rel="stylesheet" href="stylesheets/style.css" />
    <script defer src="/javascripts/search.js"></script>
    <script defer src="/javascripts/favorites.js"></script>
    <script defer src="/javascripts/basket.js"></script>
  </head>

  <body>
    <header>
      <div class="site__header">
        <img src="/images/logo-mobile.webp" alt="Freaky Fashion Logo" id="header__logotyp" />

        <div class="header__top">
          <form class="header__search">
            <input
              type="text"
              id="searchInput"
              name="q"
              class="search__bar"
              placeholder="Sök produkt"
              autocomplete="off"
            />
            <div id="searchResults"></div>
          </form>

          <div class="header__icons">
            <a href="/favorites" class="favorites-header">
              <img
                src="/icons/heart-fill.svg"
                alt="heart icon"
                class="nav__icons nav__icons--favorites-size"
                id="heart__icon"
              >

              <span class="icon-count" id="favorites-count">
                <%= session?.favoritesCount || session?.favorites?.length || 0 %>
              </span>
            </a>

            <a href="/basket" class="basket-header">
              <img
                src="/icons/shopping-basket-thick.svg"
                class="nav__icons nav__icons--basket-size"
                alt="basket"
                id="basket-icon"
              >

              <span class="icon-count" id="basket-count">
                <%= session?.basketCount || session?.basket?.length || 0 %>
              </span>
            </a>

            <% if (locals.user) { %>
              <a href="/logout">
                <img
                  src="/icons/log-out.svg"
                  alt="logout icon"
                  class="nav__icons"
                >
              </a>
            <% } else { %>
              <a href="/login">
                <img
                  src="/icons/log-in.svg"
                  alt="login icon"
                  class="nav__icons"
                >
              </a>
            <% } %>
          </div>
        </div>
      </div>

      <nav class="header__nav">
        <ul>
          <li><a href="/news">Nyheter</a></li>
          <li><a href="/products">Kläder</a></li>
          <li><a href="/about">Accessoarer</a></li>
          <li><a href="/contact">Skor</a></li>
          <li><a href="/contact">Mitt konto</a></li>
          <li><a href="/">Startsida</a></li>
        </ul>
      </nav>
    </header>

    <div class="hero__info--1024-wrapper">
      <div class="hero__info--1024">
        <% if (locals.user) { %>
          <h2 class="hero__username">
            Tack för att du handlar med oss <%= locals.user.first_name %>
          </h2>
        <% } else { %>
          <h1>Freaky Fashion</h1>
        <% } %>

        <h3>Här har vi samlat allt i din kundvagn</h3>
      </div>
    </div>

    <main
  class="checkout__main <%= products.length <= 1 ? 'checkout__main--single' : '' %>"
>
<% if (products.length === 0) { %>
  <div class="product__page--checkout-wrapper">
    <div class="empty__shopping-basket">
      <h1 class="basket-empty-message">
        Din varukorg är tom
      </h1>
      <img src="\images\tom_varukorg.png" class="basket-empty-img" alt="funny image of two people smiling with no clothes">
    </div>
  </div>

<% } else { %>

<section class="checkout__hero">

  <div class="hero__info">
    <h1>Freaky Fashion</h1>
    <p>Välkommen till sommarens hetaste look!</p>
  </div>

  <div class="product__page--checkout-wrapper">

    <% products.forEach(product => { %>

      <div class="product__page--purchase-box">

        <a href="/products/<%= product.id %>">
          <img
            src="<%= product.picture_front %>"
            alt="<%= product.type %>"
            class="checkout__image"
          >
        </a>

        <div class="product__page--checkout-items">

          <div class="product__page--purchase-header">

            <h3><%= product.type %></h3>

            <h3
              class="product-price"
              data-price="<%= product.price %>"
            >
              <%= product.price * (product.quantity || 1) %> SEK
            </h3>

          </div>

          <div class="product__page--purchase-row">

            <p><%= product.brand %></p>

            <select
              name="quantity"
              class="product__page--quantity"
              data-product-id="<%= product.id %>"
            >
              <option value="1" <%= Number(product.quantity || 1) === 1 ? "selected" : "" %>>1 st</option>
              <option value="2" <%= Number(product.quantity || 1) === 2 ? "selected" : "" %>>2 st</option>
              <option value="3" <%= Number(product.quantity || 1) === 3 ? "selected" : "" %>>3 st</option>
              <option value="4" <%= Number(product.quantity || 1) === 4 ? "selected" : "" %>>4 st</option>
              <option value="5" <%= Number(product.quantity || 1) === 5 ? "selected" : "" %>>5 st</option>
            </select>

          </div>

          <div class="product__page--trash">

            <button
              class="trash-btn"
              data-product-id="<%= product.id %>"
              type="button"
            >

              <img
                src="/icons/trash.svg"
                alt="remove product"
                class="trash-icon"
              >

            </button>

          </div>

        </div>

      </div>

    <% }) %>

  </div>

</section>

<section class="checkout__page--payment">

  <%
    const orderValue = products.reduce((sum, product) => {
      return sum + Number(product.price) * Number(product.quantity || 1);
    }, 0);

    const discount = 0;

    const deliveryFee =
      orderValue >= 500 || orderValue === 0
        ? 0
        : 49;

    const total =
      orderValue + deliveryFee;
  %>

  <table class="checkout__table">

    <thead>
      <tr>
        <th colspan="2">
          <h2>Checkout</h2>
        </th>
      </tr>
    </thead>

    <tbody>

      <tr>
        <td>Rabatter</td>
        <td><%= discount %> SEK</td>
      </tr>

      <tr>
        <td>Beställningsvärde</td>
        <td id="order-value"><%= orderValue %> SEK</td>
      </tr>

      <tr>

        <td>Beräknad leveransavgift</td>

        <td id="delivery-fee">

          <% if (deliveryFee === 0) { %>

            <strong>Gratis leverans</strong>

          <% } else { %>

            <%= deliveryFee %> SEK

          <% } %>

        </td>

      </tr>

      <tr class="checkout__table-total">
        <td>Summa</td>
        <td id="total-price"><%= total %> SEK</td>
      </tr>

    </tbody>

  </table>

  <button>Fortsätt till kassan</button>
  <button>Logga in</button>

</section>

<% } %>
    </main>

    <ul class="services-items">
      <li>
        <img src="/icons/globe.svg" alt="Free shipping icon" />
        Gratis frakt och returer
      </li>
      <li>
        <img src="/icons/airplane.svg" alt="Express delivery icon" />
        Expressfrakt
      </li>
      <li>
        <img src="/icons/shield.svg" alt="Safe payments icon" />
        Säkra betalningar
      </li>
      <li>
        <img src="/icons/smile-emoji.svg" alt="News every day icon" />
        Nyheter varje dag
      </li>
    </ul>

    <footer>
      <div class="accordion">
        <div class="accordion-container">
          <div class="accordion-item">
            <input type="checkbox" id="item-1" />
            <label for="item-1" class="accordion-header">Shopping</label>

            <div class="accordion-content">
              <ul>
                <li><a href="#">Vinterjackor</a></li>
                <li><a href="#">Pufferjackor</a></li>
                <li><a href="#">Kappa</a></li>
                <li><a href="#">Trenchcoats</a></li>
              </ul>
            </div>
          </div>

          <div class="accordion-item">
            <input type="checkbox" id="item-2" aria-label="Visa Mina Sidor" />
            <label for="item-2" class="accordion-header">Mina Sidor</label>

            <div class="accordion-content">
              <ul>
                <li><a href="#">Orderhistorik</a></li>
                <li><a href="#">Adressbok</a></li>
                <li><a href="#">Sparade kort</a></li>
                <li><a href="#">Personuppgifter</a></li>
              </ul>
            </div>
          </div>

          <div class="accordion-item">
            <input type="checkbox" id="item-3" aria-label="Visa kundtjänst" />
            <label for="item-3" class="accordion-header">Kundtjänst</label>

            <div class="accordion-content">
              <ul>
                <li><a href="#">Vanliga frågor</a></li>
                <li><a href="#">Retur & reklamation</a></li>
                <li><a href="#">Kontakta oss</a></li>
                <li><a href="#">Storleksguide</a></li>
              </ul>
            </div>
          </div>
        </div>
      </div>

      <div class="copyright">
        <p>&copy; 2024 Freaky Fashion. All rights reserved.</p>
      </div>
    </footer>
  </body>
</html>
<!DOCTYPE html>
<html lang="en">
  <%- include("partials/head", {
    title: "Varukorg",
    scripts: [
      "/javascripts/search.js",
      "/javascripts/favorites.js",
      "/javascripts/basket.js"
    ]
  }) %>

  <body>
    <%- include("partials/header") %>

    <div class="hero__info--1024-wrapper">
      <div class="hero__info--1024">
        <% if (locals.user) { %>
          <h2 class="hero__username">
            Tack för att du handlar med oss <%= locals.user.first_name %>
          </h2>
        <% } else { %>
          <h1>Freaky Fashion</h1>
        <% } %>

        <h3>Här har vi samlat allt i din kundvagn</h3>
      </div>
    </div>

    <main class="checkout__main <%= products.length <= 1 ? 'checkout__main--single' : '' %>">
      <% if (products.length === 0) { %>
        <div class="product__page--checkout-wrapper">
          <div class="empty__shopping-basket">
            <h1 class="basket-empty-message">
              Din varukorg är tom
            </h1>

            <img
              src="/images/tom_varukorg.png"
              class="basket-empty-img"
              alt="Tom varukorg"
            >
          </div>
        </div>
      <% } else { %>
        <section class="checkout__hero">
          <div class="hero__info">
            <h1>Freaky Fashion</h1>
            <p>Välkommen till sommarens hetaste look!</p>
          </div>

          <div class="product__page--checkout-wrapper">
            <% products.forEach(product => { %>
              <div class="product__page--purchase-box">
                <a href="/products/<%= product.id %>">
                  <img
                    src="<%= product.picture_front %>"
                    alt="<%= product.type %>"
                    class="checkout__image"
                  >
                </a>

                <div class="product__page--checkout-items">
                  <div class="product__page--purchase-header">
                    <h3><%= product.type %></h3>

                    <h3
                      class="product-price"
                      data-price="<%= product.price %>"
                    >
                      <%= product.price * (product.quantity || 1) %> SEK
                    </h3>
                  </div>

                  <div class="product__page--purchase-row">
                    <p><%= product.brand %></p>

                    <select
                      name="quantity"
                      class="product__page--quantity"
                      data-product-id="<%= product.id %>"
                    >
                      <% for (let i = 1; i <= 5; i++) { %>
                        <option
                          value="<%= i %>"
                          <%= Number(product.quantity || 1) === i ? "selected" : "" %>
                        >
                          <%= i %> st
                        </option>
                      <% } %>
                    </select>
                  </div>

                  <div class="product__page--trash">
                    <button
                      class="trash-btn"
                      data-product-id="<%= product.id %>"
                      type="button"
                    >
                      <img
                        src="/icons/trash.svg"
                        alt="Ta bort produkt"
                        class="trash-icon"
                      >
                    </button>
                  </div>
                </div>
              </div>
            <% }) %>
          </div>
        </section>

        <section class="checkout__page--payment">
          <%
            const orderValue = products.reduce((sum, product) => {
              return sum + Number(product.price) * Number(product.quantity || 1);
            }, 0);

            const discount = 0;
            const deliveryFee = orderValue >= 500 || orderValue === 0 ? 0 : 49;
            const total = orderValue + deliveryFee;
          %>

          <table class="checkout__table">
            <thead>
              <tr>
                <th colspan="2">
                  <h2>Checkout</h2>
                </th>
              </tr>
            </thead>

            <tbody>
              <tr>
                <td>Rabatter</td>
                <td><%= discount %> SEK</td>
              </tr>

              <tr>
                <td>Beställningsvärde</td>
                <td id="order-value"><%= orderValue %> SEK</td>
              </tr>

              <tr>
                <td>Beräknad leveransavgift</td>
                <td id="delivery-fee">
                  <% if (deliveryFee === 0) { %>
                    <strong>Gratis leverans</strong>
                  <% } else { %>
                    <%= deliveryFee %> SEK
                  <% } %>
                </td>
              </tr>

              <tr class="checkout__table-total">
                <td>Summa</td>
                <td id="total-price"><%= total %> SEK</td>
              </tr>
            </tbody>
          </table>

          <button type="button">Fortsätt till kassan</button>

          <% if (!locals.user) { %>
            <a href="/login" class="admin__button">Logga in</a>
          <% } %>
        </section>
      <% } %>
    </main>

    <%- include("partials/services") %>
    <%- include("partials/footer") %>
  </body>
</html>
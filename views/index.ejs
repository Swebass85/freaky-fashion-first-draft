<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Freaky Fashion</title>
    <link rel="icon" href="icons/favicon-16px.png" />
    <link rel="stylesheet" href="stylesheets/style.css" />
    <script defer src="/javascripts/search.js"></script>
    <script defer src="/javascripts/favorites.js"></script>
    <script defer src="/javascripts/basket.js"></script>
  </head>
  <body>
    
    <header>
      
      <div class="site__header">
        <img src="/images/logo-mobile.webp" alt="Freaky Fashion Logo" id="header__logotyp" />
        
<div class="header__top">

  <form class="header__search">

    <input
      type="text"
      id="searchInput"
      name="q"
      class="search__bar"
      placeholder="Sök produkt"
      autocomplete="off"
    />

    <div id="searchResults"></div>

  </form>




          
          
          
          
<div class="header__icons">

  
  
  <a href="/favorites" class="favorites-header">

  <img 
    src="/icons/heart-fill.svg" 
    alt="heart icon" 
    class="nav__icons nav__icons--favorites-size"
    id="heart__icon"
  >

  <span class="icon-count" id="favorites-count">
    <%= session?.favoritesCount || session?.favorites?.length || 0 %>
  </span>

</a>

<a href="/basket" class="basket-header">

  <img 
    src="/icons/shopping-basket-thick.svg"
    class="nav__icons nav__icons--basket-size"
    alt="basket"
    id="basket-icon"
  >

  <span class="icon-count" id="basket-count">
    <%= session?.basketCount || session?.basket?.length || 0 %>
  </span>

</a>
<% if (locals.user) { %>

 <a href="/logout">
    <img 
      src="/icons/log-out.svg"
      alt="login icon"
      class="nav__icons"
    >
  </a>

<% } else { %>

  <a href="/login">
    <img 
      src="/icons/log-in.svg"
      alt="login icon"
      class="nav__icons"
    >
  </a>

<% } %>

</div>
        </div> <!-- /header__top -->
      </div> <!-- /site-header -->
        
        <nav class="header__nav">
          <ul>
            <li><a href="/news">Nyheter</a></li>
            <li><a href="/products">Kläder</a></li>
            <li><a href="/about">Accessoarer</a></li>
            <li><a href="/contact">Skor</a></li>
            <li><a href="/contact">Mitt konto</a></li>
            <% if (session?.isAdmin) { %>
            <li>
              <a href="/administration">Administration</a>
            </li>
            <% } %>
            </ul>
          </nav>
    </header>

    <main class="main">
      <section class="hero">
        <video class="hero__video" autoplay muted loop playsinline>
          <source src="/images/hero-video.mp4" type="video/mp4">
        </video>
        <div class="hero__info">
          <h1>Freaky Fashion</h1>
          <p>Välkommen till sommarens hetaste look!</p>
        </div>
        <div class="hero__info--1024-wrapper">
          <div class="hero__info--1024">
            <% if (!locals.user) { %>
  <h1>Freaky Fashion</h1>
<% } %>
             <% if (locals.user) { %>
    <h2 class="hero__username">
      Hej <%= locals.user.first_name %>
    </h2>
  <% } %>
            <p>Välkommen till sommarens hetaste look!</p>
          </div>
        </div><!-- /hero__info--1024-wrapper -->
      </section>
      <section class="spots">
        <div class="spots__card">
          <img 
            src="/images/women/spots-women.webp" 
            class="spots__card--image"
            alt="Womens fashion image"
          >
          <div class="spots__card--overlay">
            <h1>Dam</h1>
          </div>
        </div>
        <div class="spots__card">
          <img 
            src="/images/Men/spots-men.webp" 
            class="spots__card--image"
            alt="Mens fashion image"
          >
          <div class="spots__card--overlay">
            <h1>Herr</h1>
          </div>
        </div>
        <div class="spots__card">
          <img 
            src="/images/kids/spots-kids.webp" 
            class="spots__card--image"
            alt="Kids fashion image"
          >
          <div class="spots__card--overlay">
            <h1>Barn</h1>
          </div>
        </div>
      </section>
      <section class="products">
        <% products.forEach(product => { %>
       <div class="product__card">

  <div class="product__card--wrapper">

    <a href="/products/<%= product.id %>" class="product__link">

      <div class="product__card--image-container">
        <img 
          src="<%= product.picture_front %>" 
          alt="<%= product.type %>" 
          class="product__card--image product__card--image-front"
        >

        <img 
          src="<%= product.picture_back %>"
          alt="<%= product.type %>"
          class="product__card--image product__card--image-back"
        > 
      </div>

    </a>

    <% if (product.age_days <= 7) { %>
      <button class="nyheter">Nyheter</button>
    <% } %>

    <div class="product__card--info">

      <div class="product__card--info--header">
        <h3><%= product.type %></h3>
        <p><%= product.brand %></p>
      </div>

      <div class="product__card--icons-wrapper">

        <p><%= product.price %> SEK</p>

        <div class="product__card--icons">

          <button 
  class="icon-toggle icon-toggle--basket basket-btn <%= session?.basket?.includes(product.id) ? 'active' : '' %>"
            data-product-id="<%= product.id %>"
            type="button"
          >
            <img src="/icons/shopping-basket.svg" class="icon-toggle__empty" alt="basket">
            <img src="/icons/shopping-basket-thick.svg" class="icon-toggle__fill" alt="basket filled">
          </button>

          <button 
            class="icon-toggle icon-toggle--heart favorite-btn <%= product.isFavorite ? 'active' : '' %>"
            data-product-id="<%= product.id %>"
            type="button"
          >
            <img src="/icons/heart.svg" class="icon-toggle__empty" alt="heart">
            <img src="/icons/heart-fill.svg" class="icon-toggle__fill" alt="heart filled">
          </button>

        </div>

      </div>

    </div>

  </div>

</div>
        <% }) %>   
      </section>
     
      <ul class="services-items">
        <li>
          <img src="/icons/globe.svg" alt="Free shipping icon" />
          Gratis frakt och returer
        </li>
        <li>
          <img src="/icons/airplane.svg" alt="Express delivery icon" />
          Expressfrakt
        </li>
        <li>
          <img src="/icons/shield.svg" alt="Safe payments icon" />
          Säkra betalningar
        </li>
        <li>
          <img src="/icons/smile-emoji.svg" alt="News every day icon" />
          Nyheter varje dag
        </li>
      </ul>
    </main> <!-- /main -->

    <footer>
      <!-- ACCORDION (shopping, my pages, customer service) -->

      <div class="accordion">
        <!-- Shopping -->
        <div class="accordion-container">
          <div class="accordion-item">
            <input type="checkbox" id="item-1" />
            <label for="item-1" class="accordion-header">Shopping</label>
            <div class="accordion-content">
              <ul>
                <li><a href="#">Vinterjackor</a></li>
                <li><a href="#">Pufferjackor</a></li>
                <li><a href="#">Kappa</a></li>
                <li><a href="#">Trenchcoats</a></li>
              </ul>
            </div>
          </div>

          <!-- Mina Sidor -->
          <div class="accordion-item">
            <input type="checkbox" id="item-2" aria-label="Visa Mina Sidor" />
            <label for="item-2" class="accordion-header">Mina Sidor</label>
            <div class="accordion-content">
              <ul>
                <li><a href="#">Orderhistorik</a></li>
                <li><a href="#">Adressbok</a></li>
                <li><a href="#">Sparade kort</a></li>
                <li><a href="#">Personuppgifter</a></li>
              </ul>
            </div>
          </div>

          <!-- Kundtjänst -->
          <div class="accordion-item">
            <input type="checkbox" id="item-3" aria-label="Visa kundtjänst" />
            <label for="item-3" class="accordion-header">Kundtjänst</label>
            <div class="accordion-content">
              <ul>
                <li><a href="#">Vanliga frågor</a></li>
                <li><a href="#">Retur & reklamation</a></li>
                <li><a href="#">Kontakta oss</a></li>
                <li><a href="#">Storleksguide</a></li>
              </ul>
            </div> <!-- /accordion-content -->
          </div> <!-- /accordion-item -->
        </div> <!-- /accordion-container -->
      </div> <!-- /accordion -->

      <div class="copyright">
        <p>&copy; 2024 Freaky Fashion. All rights reserved.</p>
      </div>
    </footer>
  </body>
</html>

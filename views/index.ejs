<!DOCTYPE html>
<html lang="en">
  <%- include("partials/head", {
    title: "Freaky Fashion",
    scripts: [
      "/javascripts/search.js",
      "/javascripts/favorites.js",
      "/javascripts/basket.js"
    ]
  }) %>

  <body>
    <%- include("partials/header") %>

    <main class="main">
      <section class="hero">
        <video class="hero__video" autoplay muted loop playsinline>
          <source src="/images/hero-video.mp4" type="video/mp4">
        </video>

        <div class="hero__info">
          <h1>Freaky Fashion</h1>
          <p>Välkommen till sommarens hetaste look!</p>
        </div>

        <div class="hero__info--1024-wrapper">
          <div class="hero__info--1024">
            <% if (!locals.user) { %>
              <h1>Freaky Fashion</h1>
            <% } %>

            <% if (locals.user) { %>
              <h2 class="hero__username">
                Hej <%= locals.user.first_name %>
              </h2>
            <% } %>

            <p>Välkommen till sommarens hetaste look!</p>
          </div>
        </div>
      </section>

      <section class="spots">
        <div class="spots__card">
          <img
            src="/images/women/spots-women.webp"
            class="spots__card--image"
            alt="Womens fashion image"
          >

          <div class="spots__card--overlay">
            <h1>Dam</h1>
          </div>
        </div>

        <div class="spots__card">
          <img
            src="/images/Men/spots-men.webp"
            class="spots__card--image"
            alt="Mens fashion image"
          >

          <div class="spots__card--overlay">
            <h1>Herr</h1>
          </div>
        </div>

        <div class="spots__card">
          <img
            src="/images/kids/spots-kids.webp"
            class="spots__card--image"
            alt="Kids fashion image"
          >

          <div class="spots__card--overlay">
            <h1>Barn</h1>
          </div>
        </div>
      </section>

      <section class="products">
        <% products.forEach(product => { %>
          <%- include("partials/product-card", { product }) %>
        <% }) %>
      </section>

      <%- include("partials/services") %>
    </main>

    <%- include("partials/footer") %>
  </body>
</html>